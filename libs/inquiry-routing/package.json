{
  "name": "ava-langchain-inquiry-routing",
  "version": "0.1.2",
  "description": "Inquiry Routing primitives for the Ava LangStack — transforms PDE decompositions into structured Inquiries routed to QMD (local semantic) and deep-search (academic) channels, grounded in Medicine Wheel epistemology and Wilson's relational ontology",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "build:compile": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "peerDependencies": {
    "ava-langchain-prompt-decomposition": ">=0.1.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.0",
    "ava-langchain-prompt-decomposition": "^0.1.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}