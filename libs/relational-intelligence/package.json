{
  "name": "ava-langchain-relational-intelligence",
  "version": "0.1.4",
  "description": "Relational Intelligence for the Narrative Intelligence Stack - Medicine Wheel ontology, importance units, epistemic iteration, value gates, and Fire Keeper coordination grounded in Indigenous relational paradigms",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avadisabelle/ava-langchainjs.git",
    "directory": "libs/relational-intelligence"
  },
  "keywords": [
    "langchain",
    "relational",
    "intelligence",
    "medicine-wheel",
    "indigenous",
    "ontology",
    "importance",
    "epistemic",
    "ceremony",
    "fire-keeper"
  ],
  "author": "ava",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": ">=0.1.0",
    "uuid": "^9.0.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.1.0",
    "ava-langchain-narrative-tracing": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "ava-langchain-narrative-tracing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}